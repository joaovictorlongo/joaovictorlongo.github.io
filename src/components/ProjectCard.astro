---
import { getLocale, projectPath } from '../data/i18n';

export interface Props {
  name: string;
  description: string;
  language: string;
  languages: string[];
  topics: string[];
  stars: number;
  forks: number;
  url: string;
  slug: string;
  locale?: 'en-US' | 'pt-BR';
}

const { name, description, language, languages, topics, stars, forks, url, slug, locale: propLocale } = Astro.props;
const locale = propLocale ?? getLocale(Astro.url.pathname);
const langColor: Record<string, string> = {
  TypeScript: '#3178c6',
  JavaScript: '#f7df1e',
  HTML: '#e34f26',
  CSS: '#1572b6',
  Dockerfile: '#2496ed',
};
---

<article class="project-card fade-in">
  <a href={projectPath(locale, slug)} class="project-card__link" aria-label={`${locale === 'en-US' ? 'View details for project' : 'Ver detalhes do projeto'} ${name}`}>
    <div class="project-card__accent"></div>
    <div class="project-card__body">
      <div class="project-card__header">
        <div class="project-card__title-row">
          <svg class="project-card__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 0 3-3h7z"/></svg>
          <h3 class="project-card__name">{name}</h3>
        </div>
        <div class="project-card__stats">
          {stars > 0 && (
            <span class="project-card__stat" title="Estrelas">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {stars}
            </span>
          )}
          {forks > 0 && (
            <span class="project-card__stat" title="Forks">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"/><path d="M12 12v3"/></svg>
              {forks}
            </span>
          )}
        </div>
      </div>
      <p class="project-card__description">{description}</p>
      <div class="project-card__footer">
        <div class="project-card__topics">
          {topics.slice(0, 3).map((topic) => (
            <span class="tag">{topic}</span>
          ))}
        </div>
        <div class="project-card__meta">
          <span class="project-card__language" style={`--lang-color: ${langColor[language] || '#888'}`}>
            <span class="project-card__lang-dot"></span>
            {language}
          </span>
          <span class="project-card__external" aria-label={`${name} no GitHub`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </span>
        </div>
      </div>
    </div>
  </a>
</article>

<style>
  .project-card {
    position: relative;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }

  .project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-light));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 24px var(--accent-glow), 0 0 0 1px var(--accent-glow);
    transform: translateY(-2px);
  }

  .project-card:hover::before {
    opacity: 1;
  }

  .project-card__link {
    text-decoration: none;
    color: inherit;
    display: block;
    height: 100%;
  }

  .project-card__body {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .project-card__title-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-width: 0;
  }

  .project-card__icon {
    color: var(--accent);
    flex-shrink: 0;
    opacity: 0.8;
  }

  .project-card__name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    font-family: var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .project-card__stats {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-shrink: 0;
  }

  .project-card__stat {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .project-card__description {
    font-size: 0.875rem;
    color: var(--text);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .project-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--border-light);
  }

  .project-card__topics {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-shrink: 0;
  }

  .project-card__language {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .project-card__lang-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lang-color, #888);
  }

  .project-card__external {
    display: inline-flex;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .project-card__external:hover {
    color: var(--accent);
  }

  @media (max-width: 420px) {
    .project-card__body {
      padding: var(--space-md);
    }

    .project-card__footer {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }
  }
</style>
