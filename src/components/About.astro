---
import profile from '../data/profile.json';
import { copy, getLocale } from '../data/i18n';

const locale = getLocale(Astro.url.pathname);
const ui = copy[locale];
---

<section class="about" aria-label={ui.about.sectionLabel}>
  <div class="container--text">
    <span class="section-label fade-in">{ui.about.sectionLabel}</span>
    <h2 class="about__title fade-in">{ui.about.title}</h2>
    {
      ui.about.bio.map((paragraph, i) => (
        <p class="about__text fade-in" style={`animation-delay: ${0.2 + i * 0.15}s`}>
          {paragraph}
        </p>
      ))
    }
    <div class="about__meta fade-in" style="animation-delay: 0.5s">
      <div class="about__meta-item">
        <span class="about__meta-label">{ui.about.location}</span>
        <span class="about__meta-value">{profile.location}</span>
      </div>
      <div class="about__meta-item">
        <span class="about__meta-label">{ui.about.email}</span>
        <div class="about__email-row">
          <span class="about__meta-value">joaovictorlongoo@gmail.com</span>
          <button class="about__copy-btn" id="copyEmailBtn" aria-label={ui.about.email}>
            <svg class="about__copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span class="about__copy-text">{ui.about.copy}</span>
          </button>
        </div>
      </div>
    </div>
    <div class="about__skills fade-in" style="animation-delay: 0.6s">
      <h3 class="about__skills-title">{ui.about.stack}</h3>
      <div class="about__skills-list">
        {ui.about.skills.map((skill) => (
          <span class="tag">{skill}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 24%),
      var(--bg-surface);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .about__title {
    margin-bottom: var(--space-lg);
  }

  .about__text {
    color: var(--text);
    font-size: 1.0625rem;
    line-height: 1.85;
    margin-bottom: var(--space-md);
  }

  .about__meta {
    display: flex;
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    background: var(--bg-muted);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
  }

  .about__meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .about__meta-label {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .about__meta-value {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
  }

  .about__email-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .about__copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .about__copy-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .about__copy-btn.copied {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--tag-bg);
  }

  .about__copy-icon {
    flex-shrink: 0;
  }

  .about__skills {
    margin-top: var(--space-xl);
  }

  .about__skills-title {
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
    color: var(--text);
  }

  .about__skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  @media (max-width: 640px) {
    .about__meta {
      flex-direction: column;
      gap: var(--space-md);
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('copyEmailBtn');
    if (!btn) return;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('joaovictorlongoo@gmail.com');
        btn.classList.add('copied');
        const textEl = btn.querySelector('.about__copy-text');
        if (textEl) textEl.textContent = ui.about.copied;
        setTimeout(() => {
          btn.classList.remove('copied');
          if (textEl) textEl.textContent = ui.about.copy;
        }, 2000);
      } catch {
        const input = document.createElement('input');
        input.value = 'joaovictorlongoo@gmail.com';
        input.style.position = 'fixed';
        input.style.opacity = '0';
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
        btn.classList.add('copied');
        const textEl = btn.querySelector('.about__copy-text');
        if (textEl) textEl.textContent = ui.about.copied;
        setTimeout(() => {
          btn.classList.remove('copied');
          if (textEl) textEl.textContent = ui.about.copy;
        }, 2000);
      }
    });
  });
</script>
