---
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import pinned from '../../data/pinned-repos.json';

export async function getStaticPaths() {
  return pinned.map((repo) => ({
    params: { slug: repo.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') },
    props: { repo },
  }));
}

const { repo } = Astro.props;
const langColor: Record<string, string> = {
  TypeScript: '#3178c6',
  JavaScript: '#f7df1e',
  HTML: '#e34f26',
  CSS: '#1572b6',
  Dockerfile: '#2496ed',
};

const readmeHtml = repo.readme_full
  ? marked.parse(repo.readme_full, { breaks: true, gfm: true })
  : '';
---

<BaseLayout
  title={repo.name}
  description={repo.description}
  url={`https://joaovictorlongo.github.io/projeto/${repo.name}`}
  type="article"
>
  <article class="project-detail">
    <div class="container">
      <a href="/projetos" class="project-detail__back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Voltar
      </a>

      <h1 class="project-detail__title">{repo.name}</h1>

      <div class="project-detail__meta">
        <div class="project-detail__language" style={`--lang-color: ${langColor[repo.language] || '#888'}`}>
          <span class="project-detail__lang-dot"></span>
          {repo.language}
        </div>
        <span class="tag">⭐ {repo.stars}</span>
        <span class="tag">⑂ {repo.forks} forks</span>
        {repo.license && <span class="tag">{repo.license}</span>}
      </div>

      <div class="project-detail__topics">
        {repo.topics.map((topic: string) => (
          <span class="tag">{topic}</span>
        ))}
      </div>

      {readmeHtml ? (
        <div class="project-detail__readme">
          <div class="readme-content" set:html={readmeHtml} />
        </div>
      ) : (
        <p class="project-detail__description">{repo.description}</p>
      )}

      <hr class="project-detail__hr" />

      <h2>Linguagens</h2>
      <div class="project-detail__lang-list">
        {repo.languages.map((lang: string) => (
          <span class="project-detail__lang-item" style={`--lang-color: ${langColor[lang] || '#888'}`}>
            <span class="project-detail__lang-dot-sm"></span>
            {lang}
          </span>
        ))}
      </div>

      <div class="project-detail__actions">
        <a href={repo.url} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          Ver no GitHub
        </a>
        {repo.homepage && (
          <a href={repo.homepage} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            Acessar demo
          </a>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail {
    padding: var(--space-4xl) 0 var(--space-5xl);
  }

  .project-detail__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
    text-decoration: none;
    font-weight: 500;
  }

  .project-detail__back:hover {
    color: var(--accent);
  }

  .project-detail__title {
    margin-bottom: var(--space-md);
    font-family: var(--font-mono);
  }

  .project-detail__meta {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-lg);
  }

  .project-detail__language {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .project-detail__lang-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--lang-color, #888);
  }

  .project-detail__topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .project-detail__description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-2xl);
  }

  .project-detail__hr {
    border: none;
    border-top: 1px solid var(--border-light);
    margin: var(--space-3xl) 0;
  }

  .project-detail__readme {
    margin-bottom: var(--space-xl);
    max-width: 740px;
  }

  .readme-content {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .readme-content h1,
  .readme-content h2,
  .readme-content h3 {
    font-family: var(--font-body);
    color: var(--text);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .readme-content h1 { font-size: 1.5rem; }
  .readme-content h2 { font-size: 1.25rem; }
  .readme-content h3 { font-size: 1.125rem; }

  .readme-content p {
    margin-bottom: var(--space-md);
  }

  .readme-content ul,
  .readme-content ol {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
  }

  .readme-content li {
    margin-bottom: var(--space-xs);
  }

  .readme-content code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: var(--bg-muted);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .readme-content pre {
    background: var(--bg-muted);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    overflow-x: auto;
    margin-bottom: var(--space-md);
  }

  .readme-content pre code {
    background: none;
    padding: 0;
    border-radius: 0;
  }

  .readme-content a {
    color: var(--accent);
  }

  .readme-content a:hover {
    color: var(--accent-light);
  }

  .readme-content img {
    max-width: 100%;
    border-radius: var(--radius-md);
    margin: var(--space-md) 0;
  }

  .readme-content blockquote {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-md);
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .readme-content hr {
    border: none;
    border-top: 1px solid var(--border-light);
    margin: var(--space-lg) 0;
  }

  .readme-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-md);
  }

  .readme-content th,
  .readme-content td {
    border: 1px solid var(--border-light);
    padding: var(--space-sm) var(--space-md);
    text-align: left;
    font-size: 0.875rem;
  }

  .readme-content th {
    background: var(--bg-muted);
    font-weight: 600;
  }

  .project-detail__lang-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  .project-detail__lang-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.875rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }

  .project-detail__lang-dot-sm {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lang-color, #888);
  }

  .project-detail__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  h2 {
    font-size: 1.25rem;
    margin-bottom: var(--space-md);
  }
</style>
