---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import pinned from '../../data/pinned-repos.json';
import { copy, getLocale } from '../../data/i18n';

const locale = getLocale(Astro.url.pathname);
const ui = copy[locale];
---

<BaseLayout
  title="João Victor Longo"
  description={ui.hero.tagline}
  url="https://joaovictorlongo.github.io/pt-br"
>
  <Hero />
  <About />
  <section class="home-projects" aria-label={ui.projects.sectionLabel}>
    <div class="container">
      <span class="section-label">{ui.projects.sectionLabel}</span>
      <h2>{ui.projects.title}</h2>
      <p class="home-projects__subtitle">{ui.projects.subtitle}</p>
    </div>
    <div class="container">
      <ProjectGrid repos={pinned} />
    </div>
  </section>
</BaseLayout>

<style>
  .home-projects__subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    margin-top: var(--space-sm);
    margin-bottom: var(--space-2xl);
    max-width: 620px;
    line-height: 1.75;
  }
</style>
