---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { copy, getLocale } from '../../../data/i18n';

const locale = getLocale(Astro.url.pathname);
const ui = copy[locale];
---

<BaseLayout title={ui.blog.pageTitle} description={ui.blog.pageDescription}>
  <div class="blog">
    <div class="container--text">
      <span class="section-label fade-in">{ui.blog.sectionLabel}</span>
      <h1 class="blog__title fade-in">{ui.blog.title}</h1>
      <p class="blog__empty fade-in">{ui.blog.emptyBody}</p>
    </div>
  </div>
</BaseLayout>

<style>
  .blog {
    min-height: calc(100vh - 60px - 120px);
  }

  .blog__title {
    margin-bottom: var(--space-lg);
  }

  .blog__empty {
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
</style>
