---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import pinned from '../../data/pinned-repos.json';
---

<BaseLayout
  title="Projetos"
  description="Projetos públicos em destaque no GitHub de João Victor Longo"
  url="https://joaovictorlongo.github.io/projetos"
>
  <section class="projects-page">
    <div class="container">
      <span class="section-label">Projetos</span>
      <h1>Projetos</h1>
    </div>
    <div class="container">
      <ProjectGrid repos={pinned} />
    </div>
  </section>
</BaseLayout>
