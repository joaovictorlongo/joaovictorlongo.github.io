---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocale } from '../data/i18n';

export interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  type?: string;
}

const { title, description, image, url, type } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'João Victor Longo',
  givenName: 'João Victor',
  familyName: 'Longo',
  jobTitle: 'AI Engineer & Fullstack Developer',
  worksFor: { '@type': 'Organization', name: 'Field Control' },
  url: 'https://joaovictorlongo.github.io',
  sameAs: [
    'https://github.com/joaovictorlongo',
    'https://www.linkedin.com/in/joaovictorlongo/',
  ],
  knowsAbout: [
    'TypeScript', 'JavaScript', 'Node.js', 'Angular', 'NestJS',
    'React', 'PostgreSQL', 'Docker', 'Bun', 'Elysia', 'NativeScript',
    'LLMs', 'AI products', 'automation', 'product engineering',
  ],
  homeLocation: { '@type': 'Place', address: 'São José do Rio Preto — SP, Brasil' },
};
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="Astro" />
    <meta name="theme-color" content="#0b0b14" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%2306b6d4'/%3E%3Ctext x='50' y='68' font-family='system-ui' font-size='50' font-weight='bold' fill='white' text-anchor='middle'%3EJL%3C/text%3E%3C/svg%3E" />
    <SeoHead title={title} description={description} image={image} url={url} type={type} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Pular para o conteúdo</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  html {
    scroll-padding-top: 60px;
  }
</style>
